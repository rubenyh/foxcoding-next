# Supabase project settings: Project URL and the publishable (or legacy anon) key.
# Copy this file to .env.local and fill in the values. Never use a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
